PORT=4000
MONGODB_URI=
JWT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# File speech-to-text model (Audio Transcriptions API). Default gpt-transcribe; whisper-1 still works until ~2027.
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
CORS_ORIGIN=*
# Optional — Expo access token for Push API (higher limits / project scope). Not required for basic test pushes.
EXPO_ACCESS_TOKEN=
